---
import Base from "../layouts/Base.astro";
---

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .row {
    padding: 0.35rem 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 480px) {
    .home {
      min-height: calc(100dvh - 6rem);
      justify-content: center;
      font-size: 1.2rem;
    }
  }
</style>

<Base title="Tianpai">
  <div class="home">
    <div class="section">
      <div class="row"><a href="/blog" data-sound="tap_03">blogs</a></div>
      <div class="row">
        <a href="/projects" data-sound="tap_03">projects</a>
      </div>
    </div>

    <div class="section">
      <div class="row">
        <a href="/search" data-sound="tap_03">search</a>
      </div>
      <div class="row"><a href="/about" data-sound="tap_03">about</a></div>
    </div>
  </div>
</Base>
