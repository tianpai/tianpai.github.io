---
import "../styles/global.css";
import Breadcrumb from "../components/Breadcrumb.astro";
import Color from "../components/color.astro";

interface Props {
  title: string;
  breadcrumbTitle?: string;
}

const { title, breadcrumbTitle } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <Color />
  </head>
  <body>
    <Breadcrumb title={breadcrumbTitle} />
    <slot />
  </body>
</html>

<script>
  import { playSound } from "../scripts/sound";

  document.addEventListener("mousedown", (event) => {
    if (!(event.target instanceof Element)) {
      return;
    }

    const target = event.target.closest<HTMLElement>("[data-sound]");
    const sound = target?.dataset.sound;
    if (sound) {
      void playSound(sound);
    }
  });
</script>
