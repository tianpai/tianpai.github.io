---
interface Props {
  name: string;
  type?: string;
  description?: string;
  links?: { label: string; url: string }[];
}

const { name, type, description, links = [] } = Astro.props;
---

<li>
  <div class="row">
    <span class="name"
      >{name.toLocaleUpperCase()}{
        type && <span class="type"> | {type}</span>
      }</span
    >
    {
      links.length > 0 && (
        <span class="links">
          [
          {links.map((l, i) => (
            <>
              {i > 0 && " | "}
              <a href={l.url} target="_blank" rel="noopener noreferrer">
                {l.label}
              </a>
            </>
          ))}
          ]
        </span>
      )
    }
  </div>
  {description && <div class="desc">{description}</div>}
</li>

<style>
  li {
    padding: 0.5rem 0;
  }
  .row {
    display: flex;
    justify-content: space-between;
  }
  .type {
    color: var(--text-muted);
  }
  .links {
    color: var(--text-muted);
    white-space: nowrap;
  }
  .desc {
    color: var(--text-muted);
  }
</style>
